@Silver_Task.Server_HostAddress = http://localhost:5056

GET {{Silver_Task.Server_HostAddress}}/api/health
Accept: application/json

###

# Creates the first user (Administrator). Only works while the Users table is empty;
# afterwards this endpoint requires an authenticated Administrator.
POST {{Silver_Task.Server_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Admin",
  "email": "admin@silvertask.local",
  "password": "changeme123",
  "role": "Administrator"
}

###

POST {{Silver_Task.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@silvertask.local",
  "password": "changeme123"
}

###

GET {{Silver_Task.Server_HostAddress}}/api/auth/me
Accept: application/json

###

GET {{Silver_Task.Server_HostAddress}}/api/users
Accept: application/json

###

POST {{Silver_Task.Server_HostAddress}}/api/auth/logout

###

GET {{Silver_Task.Server_HostAddress}}/api/projects
Accept: application/json

###

POST {{Silver_Task.Server_HostAddress}}/api/projects
Content-Type: application/json

{
  "name": "Riverside Renovation",
  "description": "Permit, materials, and inspection tracking for the riverside job."
}

###

# Replace {projectId} below with an id from the responses above.

GET {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}
Accept: application/json

###

PUT {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}
Content-Type: application/json

{
  "name": "Riverside Renovation",
  "description": "Updated description"
}

###

GET {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}/members
Accept: application/json

###

POST {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}/members
Content-Type: application/json

{
  "email": "david@silvertask.local"
}

###

DELETE {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}/members/{userId}

###

# Archives the project (soft delete).
DELETE {{Silver_Task.Server_HostAddress}}/api/projects/{projectId}

