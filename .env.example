# Reference list of configuration values Silver-Task needs. ASP.NET Core does not load
# .env files directly — this file only documents the names/shapes expected. Provide real
# values via:
#   - Local development: `dotnet user-secrets set "Key:SubKey" "value"` from Silver-Task.Server/
#   - Production/CI:      environment variables using "__" (double underscore) as the section
#                          separator, e.g. ConnectionStrings__DefaultConnection
#
# Never commit an actual .env file or real credentials.

# PostgreSQL connection string used by Entity Framework Core.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=silvertask_dev;Username=postgres;Password=postgres

# Added in Phase 3 (authentication):
# Jwt__Secret=
# Jwt__Issuer=
# Jwt__Audience=
