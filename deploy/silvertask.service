# Silver-Task v1.0.0 — example systemd unit for running the published app as a persistent
# service (survives terminal disconnect, service restart, and — once enabled — server reboot).
#
# Install:
#   sudo cp deploy/silvertask.service /etc/systemd/system/silvertask.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable silvertask     # start automatically on boot
#   sudo systemctl start silvertask
#
# Logs:
#   journalctl -u silvertask -f
#
# Restart after a new deployment:
#   sudo systemctl restart silvertask
#
# Adjust WorkingDirectory/ExecStart to the actual publish output path
# (`dotnet publish Silver-Task.Server/Silver-Task.Server.csproj -c Release -o <publish-dir>`),
# User to a dedicated non-root service account with write access only to that directory and to the
# configured Attachments:StorageRoot, and ReadWritePaths (Phase 59) to match. ExecStart below assumes `dotnet` resolves via PATH
# (e.g. `command -v dotnet`) — scripts/install-debian.sh installs it via Microsoft's official
# dotnet-install.sh to /usr/share/dotnet with a /usr/local/bin/dotnet symlink, not via apt, so
# adjust the path below if you installed .NET a different way (e.g. apt's /usr/bin/dotnet).

[Unit]
Description=Silver Task (ASP.NET Core, serves API + bundled SPA)
After=network.target postgresql.service

[Service]
# Type=simple, not notify: notify requires the app to call sd_notify(READY=1) via ASP.NET
# Core's .UseSystemd() host integration, which this app does not use. Without that, a
# Type=notify unit waits for a signal that never arrives and the start times out — found for
# real on the Debian 13 test server ("Job for silvertask.service failed because a timeout was
# exceeded"). Type=simple considers the service started as soon as the process is exec'd;
# actual readiness is verified separately, over HTTP, by scripts/install-debian.sh's own
# post-start health check against /api/health/ready.
Type=simple
WorkingDirectory=/opt/silvertask/publish
ExecStart=/usr/bin/dotnet /opt/silvertask/publish/Silver-Task.Server.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=silvertask
User=silvertask
Environment=ASPNETCORE_ENVIRONMENT=Production
# Bind Kestrel to loopback only — the reverse proxy (see deploy/nginx.conf) is what's actually
# internet-facing; Kestrel itself should never be reachable directly from outside the host.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# Real values injected via EnvironmentFile below, never hardcoded here or committed to git.
EnvironmentFile=/etc/silvertask/silvertask.env

# --- Phase 59 — systemd sandboxing, on top of running as the already-unprivileged `silvertask`
# user above. ReadWritePaths deliberately covers the whole install directory, not just the
# attachments storage root — this app's full runtime write surface (e.g. ASP.NET Core's default
# Data Protection key persistence location) couldn't be verified with confidence outside a real
# Debian host, so this is intentionally a little broader than the documented minimum rather than
# risk a plausible false-positive breakage; see docs/security-checklist.md for how to tighten it
# further once verified on your own host. WorkingDirectory/ReadWritePaths below are regenerated
# from the actual configured install directory by scripts/install-debian.sh — the values here are
# placeholders only. ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/silvertask /var/lib/silver-task/attachments
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
UMask=0027

[Install]
WantedBy=multi-user.target
