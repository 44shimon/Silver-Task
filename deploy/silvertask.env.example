# Silver-Task v1.0.0 — production environment file template.
#
# Copy to /etc/silvertask/silvertask.env (referenced by deploy/silvertask.service),
# fill in real values, and lock down permissions:
#   sudo cp deploy/silvertask.env.example /etc/silvertask/silvertask.env
#   sudo chmod 600 /etc/silvertask/silvertask.env
#   sudo chown silvertask:silvertask /etc/silvertask/silvertask.env
#
# NEVER commit the filled-in version of this file to git. This template contains no real values.

# --- Required ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=silvertask;Username=silvertask_app;Password=CHANGE_ME
# 32+ random bytes, e.g.: openssl rand -base64 48
Jwt__Secret=CHANGE_ME

# --- Required for the SPA's own links/cookies to resolve correctly behind the reverse proxy ---
Cors__AllowedOrigins__0=https://tasks.example.com

# --- Optional: email notifications (app runs fully functional without these — email is simply off) ---
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Silver Task

# --- Optional: only needed if the reverse proxy is NOT on the same host as this app
# (ForwardedHeadersMiddleware defaults to trusting loopback only — see Program.cs).
# One IP per numbered variable if there's more than one proxy hop. ---
# ForwardedHeaders__KnownProxies__0=10.0.0.5

# --- Optional: maintenance-mode flag file (Phase 54, scripts/update-debian.sh --activate).
# Empty/unset disables maintenance mode entirely (the safe default). Must be a path outside the
# publish directory (which gets replaced during an upgrade) so both the old and new binary agree
# on it — install-debian.sh sets this automatically to $SILVERTASK_INSTALL_DIR/maintenance.json. ---
# Maintenance__FlagFile=/opt/silvertask/maintenance.json

# --- Optional: release channel (Phase 56, scripts/update-debian.sh --check/--status/--latest/
# --target-version). Empty/unset defaults to "stable" (the safe default — never surfaces
# pre-release tags implicitly). Set to "beta" only to opt in to pre-release releases; an explicit
# --channel flag on the command line always overrides this. ---
# Upgrade__Channel=stable

# --- Optional: maintenance-window policy (Phase 56, scripts/update-debian.sh --activate/
# --rollback). Empty/unset means no restriction — upgrades/rollbacks are allowed at any time (the
# default). Format HH:MM-HH:MM in server-local time, e.g. a window that wraps midnight is allowed
# (22:00-04:00). Outside the window, --activate/--rollback are blocked unless
# --override-maintenance-window is also passed (requires typed confirmation). ---
# Upgrade__MaintenanceWindow=02:00-04:00

# --- Optional: diagnostics thresholds (Phase 58, GET /api/admin/diagnostics). All three have
# sane defaults — only set these if you need to tune them for your environment. See
# docs/monitoring-runbook.md. ---
# Diagnostics__DbLatencyDegradedMs=1000
# Diagnostics__DiskFreePercentDegraded=10
# Diagnostics__WorkerStaleMultiplier=3

# --- Optional: login rate limiting (Phase 59, POST /api/auth/login). On top of, not instead of,
# the existing per-account lockout (Security.MaxFailedLoginAttempts, an admin-configurable system
# setting, not an env var). Defaults are generous — well above any plausible legitimate retry
# pattern, well below what a credential-stuffing script wants. See docs/security-checklist.md. ---
# Security__LoginRateLimit__PermitLimit=10
# Security__LoginRateLimit__WindowSeconds=60
